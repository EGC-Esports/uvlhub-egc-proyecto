FLASK_APP_NAME="UVLHUB.IO"
FLASK_ENV=production
DOMAIN=<CHANGE_THIS>
# Required in production: ProductionConfig refuses to build the application
# without it, so the web container exits at boot. Use a long random value,
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<CHANGE_THIS>
# Recommended: key that encrypts the users' TOTP (2FA) secrets in the database.
# If unset, a key derived from SECRET_KEY is used, and changing SECRET_KEY then
# makes every stored TOTP secret unreadable. Comma-separated list to rotate:
# the first key encrypts, all of them decrypt. Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=<CHANGE_THIS>
MARIADB_HOSTNAME=db
MARIADB_PORT=3306
MARIADB_DATABASE=uvlhubdb
MARIADB_USER=<CHANGE_THIS>
MARIADB_PASSWORD=<CHANGE_THIS>
MARIADB_ROOT_PASSWORD=<CHANGE_THIS>
WEBHOOK_TOKEN=<CHANGE_THIS>
WORKING_DIR=/workspace/
